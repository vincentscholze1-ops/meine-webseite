{
  "manifest_version": 3,
  "name": "LSS Verbands-Bot",
  "version": "5.0.0",
  "description": "Schickt im Leitstellenspiel automatisch eine feste Fahrzeugauswahl zu Verbands- und geplanten Einsätzen – mit Live-Auslastung, Tempo-Stufen und Credit-Auswertung.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.leitstellenspiel.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.leitstellenspiel.de/",
        "https://www.leitstellenspiel.de/?*"
      ],
      "js": [
        "vehicle-types.js",
        "config.js",
        "stats.js",
        "bot.js"
      ],
      "css": [
        "bot.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LSS Verbands-Bot",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "options.html",
        "stats.html"
      ],
      "matches": [
        "https://www.leitstellenspiel.de/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
